# Required configuration
#
# Set these in Vercel → Project → Settings → Environment Variables
# (Production, Preview and Development). For local development, copy this
# file to `.env` and fill in the values.
#
# Next.js reads these on the server. Firebase and Vapi keys are passed to the
# browser as runtime configuration by the server pages — never hardcoded in the
# repository, and never prefixed with NEXT_PUBLIC_.
#
# The master agent system prompt lives in `lib/agent-system-prompt.json` and is
# only loaded by the `/api/vapi-overrides` server route.

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Vapi (public web key only — never the private key)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# WhatsApp call-summary bridge (separate Docker service)
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_SECRET=

# Optional: enables AI-generated call summaries for WhatsApp reports
GEMINI_API_KEY=

# Gmail integration (Google OAuth 2.0 with Gmail scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: enables AI-generated call summaries and Gmail features

# Firebase Admin (required for server-side RTDB access, e.g. Gmail token storage)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Facebook Pages OAuth + Messenger (Meta App Dashboard)
# Get credentials at https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional Facebook Login for Business configuration ID (recommended for Business apps)
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_REDIRECT_URI=https://your-app.example.com/api/facebook/callback
FACEBOOK_GRAPH_VERSION=v27.0
# Generate an independent secret: openssl rand -hex 32
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# 256-bit AES-GCM key (64 hex characters): openssl rand -hex 32
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# Required for /api/facebook/jobs retry worker. If using Vercel Cron, set CRON_SECRET.
CRON_SECRET=
# Optional: Gemini model for Messenger auto replies
GEMINI_MODEL=gemini-2.5-flash

# Public base URL for Vapi tool callbacks (matching deployed HTTPS origin)
APP_URL=https://your-app.example.com
